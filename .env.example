# Copy to .env and replace the two placeholders. Never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DB_PASSWORD=replace-with-local-app-password
DB_USERNAME=shuttle
DB_PORT=3307
DB_URL="jdbc:mysql://127.0.0.1:3307/campus_shuttle?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
SPRING_PROFILES_ACTIVE=demo

# Optional V0.2 driver response deadline (ISO-8601 duration)
DISPATCH_OFFER_TTL=PT2M
