[Unit]
Description=ShuttleFlow Spring Boot API
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=shuttleflow
Group=shuttleflow
WorkingDirectory=/opt/shuttleflow/current
EnvironmentFile=/etc/shuttleflow/shuttleflow.env
EnvironmentFile=/etc/shuttleflow/secrets.env
ExecStart=/usr/bin/java -Xms256m -Xmx1024m -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError -XX:ActiveProcessorCount=2 -jar /opt/shuttleflow/current/backend/target/shuttle-1.0.0.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=8192
MemoryMax=1536M
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/shuttleflow
ReadWritePaths=/var/lib/shuttleflow

[Install]
WantedBy=multi-user.target
