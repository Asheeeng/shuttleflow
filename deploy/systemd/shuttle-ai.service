[Unit]
Description=ShuttleFlow FastAPI algorithm service
After=network.target

[Service]
Type=simple
User=shuttleflow
Group=shuttleflow
WorkingDirectory=/opt/shuttleflow/current/ai-service
EnvironmentFile=/etc/shuttleflow/shuttleflow.env
EnvironmentFile=/etc/shuttleflow/secrets.env
ExecStart=/opt/shuttleflow/current/ai-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=2048
MemoryMax=512M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/shuttleflow

[Install]
WantedBy=multi-user.target
