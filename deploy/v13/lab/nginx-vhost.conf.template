server {
    listen 80;
    server_name @DOMAIN@;
    location ^~ /.well-known/acme-challenge/ {
        root @ACME_ROOT@;
        try_files $uri =404;
    }
    location / { return 308 https://@DOMAIN@$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    auth_basic off; # 登录与授权由应用会话处理
    limit_req zone=shuttle_formal_edge burst=30 nodelay;
    limit_conn shuttle_formal_conn 16;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    access_log /var/log/nginx/shuttle-formal-access.log;
    error_log /var/log/nginx/shuttle-formal-error.log warn;
    location ~ ^/api/(operation/|admin/(operation/|simulation/)) { return 404; }
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $shuttle_formal_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_set_header X-Operation-Token "";
        proxy_set_header X-Experiment-Token "";
        proxy_set_header X-Shuttle-Service-Token "";
        proxy_read_timeout 75s;
    }
}
